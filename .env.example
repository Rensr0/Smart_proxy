# 复制为 .env 或写入系统环境变量（.env 已在 .gitignore 中）
# 厂商提取链接（含 trade_no / secret，勿提交仓库）
PROXY_API_URL=http://api.91http.com/v1/get-ip?trade_no=YOUR_TRADE_NO&secret=YOUR_SECRET&num=10&protocol=1&format=json&sep=1&time=1&pw=1

# 可选：代理账密覆盖 / Redis / 监听
# PROXY_USER=
# PROXY_PASS=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=15
# REDIS_PASSWORD=
# HOST=0.0.0.0
# PORT=1234
# TUNNEL_HOST=127.0.0.1
# TUNNEL_PORT=18888
